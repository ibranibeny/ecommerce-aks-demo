<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - ShopHub</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    .hero { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 80px 0; }
    .product-card { transition: transform 0.3s, box-shadow 0.3s; border: none; }
    .product-card:hover { transform: translateY(-5px); box-shadow: 0 10px 30px rgba(0,0,0,0.15); }
    .product-img { height: 200px; object-fit: cover; }
    .badge-sale { position: absolute; top: 10px; right: 10px; }
    .rating { color: #ffc107; }
    .footer { background: #343a40; color: white; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/"><i class="fas fa-store me-2"></i>ShopHub</a>
      <div class="d-flex">
        <a href="#" class="btn btn-outline-light me-2"><i class="fas fa-shopping-cart"></i></a>
        <a href="#" class="btn btn-primary">Login</a>
      </div>
    </div>
  </nav>

  <section class="hero text-center">
    <div class="container">
      <h1 class="display-4 fw-bold mb-3">Welcome to ShopHub</h1>
      <p class="lead mb-4">Discover amazing products at unbeatable prices</p>
      <a href="#products" class="btn btn-light btn-lg px-5">Shop Now</a>
    </div>
  </section>

  <section id="products" class="py-5">
    <div class="container">
      <h2 class="text-center mb-5">Featured Products</h2>
      <div class="row g-4">
        <% products.forEach(function(product) { %>
        <div class="col-md-6 col-lg-4">
          <div class="card product-card h-100 shadow-sm">
            <div class="position-relative">
              <img src="<%= product.image %>" class="card-img-top product-img" alt="<%= product.name %>">
              <% if(product.price < 100) { %>
              <span class="badge bg-danger badge-sale">SALE</span>
              <% } %>
            </div>
            <div class="card-body">
              <span class="badge bg-secondary mb-2"><%= product.category %></span>
              <h5 class="card-title"><%= product.name %></h5>
              <p class="card-text text-muted small"><%= product.description.substring(0, 80) %>...</p>
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold text-primary fs-5">$<%= product.price %></span>
                <div class="rating">
                  <% for(let i = 0; i < Math.floor(product.rating); i++) { %>
                  <i class="fas fa-star"></i>
                  <% } %>
                  <small class="text-muted">(<%= product.rating %>)</small>
                </div>
              </div>
            </div>
            <div class="card-footer bg-white border-0">
              <a href="/product/<%= product.id %>" class="btn btn-primary w-100">View Details</a>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <footer class="footer py-4">
    <div class="container text-center">
      <p class="mb-1">&copy; 2024 ShopHub - CI/CD Demo with GitHub Actions & AKS</p>
      <small class="text-muted">Powered by Node.js, Docker & Kubernetes</small>
    </div>
  </footer>
</body>
</html>
