<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> - ShopHub</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    .product-img { max-height: 400px; object-fit: contain; }
    .feature-list { list-style: none; padding: 0; }
    .feature-list li { padding: 8px 0; border-bottom: 1px solid #eee; }
    .feature-list li:before { content: "✓"; color: #28a745; margin-right: 10px; }
    .rating { color: #ffc107; }
    .breadcrumb { background: transparent; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/"><i class="fas fa-store me-2"></i>ShopHub</a>
      <div class="d-flex">
        <a href="#" class="btn btn-outline-light me-2"><i class="fas fa-shopping-cart"></i></a>
        <a href="#" class="btn btn-primary">Login</a>
      </div>
    </div>
  </nav>

  <div class="container py-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a href="/#products"><%= product.category %></a></li>
        <li class="breadcrumb-item active"><%= product.name %></li>
      </ol>
    </nav>

    <div class="row g-5">
      <div class="col-md-6">
        <div class="card border-0 shadow">
          <img src="<%= product.image %>" class="card-img-top product-img p-4" alt="<%= product.name %>">
        </div>
      </div>
      <div class="col-md-6">
        <span class="badge bg-primary mb-2"><%= product.category %></span>
        <h1 class="fw-bold"><%= product.name %></h1>
        <div class="rating mb-3">
          <% for(let i = 0; i < Math.floor(product.rating); i++) { %>
          <i class="fas fa-star"></i>
          <% } %>
          <span class="text-muted ms-2">(<%= product.rating %> rating)</span>
        </div>
        <h2 class="text-primary fw-bold mb-4">$<%= product.price %></h2>
        <p class="lead text-muted"><%= product.description %></p>
        
        <h5 class="mt-4 mb-3">Key Features</h5>
        <ul class="feature-list">
          <% product.features.forEach(function(feature) { %>
          <li><%= feature %></li>
          <% }); %>
        </ul>

        <div class="d-grid gap-2 mt-4">
          <button class="btn btn-primary btn-lg"><i class="fas fa-cart-plus me-2"></i>Add to Cart</button>
          <button class="btn btn-outline-secondary btn-lg"><i class="fas fa-heart me-2"></i>Add to Wishlist</button>
        </div>
      </div>
    </div>

    <div class="mt-5 pt-4 border-top">
      <h3 class="mb-4">You might also like</h3>
      <div class="row g-4">
        <% relatedProducts.forEach(function(p) { %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm">
            <img src="<%= p.image %>" class="card-img-top" style="height:150px;object-fit:cover;" alt="<%= p.name %>">
            <div class="card-body">
              <h6><%= p.name %></h6>
              <p class="text-primary fw-bold mb-0">$<%= p.price %></p>
            </div>
            <div class="card-footer bg-white">
              <a href="/product/<%= p.id %>" class="btn btn-outline-primary btn-sm w-100">View</a>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>

  <footer class="bg-dark text-white py-4 mt-5">
    <div class="container text-center">
      <p class="mb-1">&copy; 2024 ShopHub - CI/CD Demo</p>
    </div>
  </footer>
</body>
</html>
